      "email": "attacker@example.com",
      "emailVerified": true,
      "firstName": "Attacker",
      "lastName": "User",
      "requiredActions": [],
      "realmRoles": []
    }
  ],
  "clients": [
    {
      "clientId": "demo",
      "name": "Demo Confidential Client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "demo-secret",
